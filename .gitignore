# Binaries and build output
/bin/
# `go build ./cmd/<name>` drops the binary in the working directory, so the
# main packages are named here rather than discovered after one is committed.
/hoplock-control
/pdpconform
/policyctl
*.exe
*.dll
*.so
*.dylib

# Test and coverage output
*.test
*.out
coverage.*

# Local configuration and secrets — never commit these
config.yaml
config.local.yaml
*.pem
*.key
!*.example.yaml

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
